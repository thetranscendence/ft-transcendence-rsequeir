
# --- HASHICORP VAULT (INFRASTRUCTURE) ---
# Token d'administration racine pour Vault en mode développement.
# Dans votre .env local, remplacez cette valeur par une chaîne aléatoire unique.
VAULT_ROOT_TOKEN=change_me_to_a_secure_token_in_local_env

# --- RABBITMQ (MESSAGERIE ASYNCHRONE) ---
# Nom d'utilisateur par défaut pour l'administration du broker.
# Le mot de passe associé sera généré automatiquement.
RABBITMQ_USER=guest

# --- POSTGRESQL (BASE DE DONNÉES) ---
# Nom du super-utilisateur pour la base de données principale.
# Le mot de passe associé sera généré automatiquement.
POSTGRES_USER=postgres

# --- NODEJS & APPLICATION (GLOBAL) ---
# Contexte d'exécution de l'application.
# Valeurs possibles : 'development' (par défaut), 'test', 'production'.
NODE_ENV=development